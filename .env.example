DATABASE_URL = "xxxxxxxxxxx"
DATABASE_URL_POOLED = "xxxxxxxxxxx"


OPENAI_API_KEY="xxxxxxxxxxx"
OPENAI_BASE_URL = "xxxxxxxxxxx"
OPENAI_MODEL_HIGH = "xxxxxxxxxxx"
OPENAI_MODEL_MEDIUM = "xxxxxxxxxxx"
OPENAI_MODEL_LOW = "xxxxxxxxxxx"
OPENAI_EVAL_MODEL = "openai:gpt-4o-mini"


ETL_ENDPOINT_URL = "https://superfree-campaign-endpoint.rhythamnegi.workers.dev/api/campaigns"
ETL_CACHE_DIR = "data/etl_cache"
# --- Arize Phoenix observability (open-source, local, no login) ---
# UI served locally via `uv run phoenix serve` at http://localhost:6006.
# Traces are exported via OTLP to the collector endpoint below.
PHOENIX_ENABLED = "true"
PHOENIX_PROJECT_NAME = "automasql"
PHOENIX_HOST = "localhost"
PHOENIX_PORT = "6006"
# PHOENIX_COLLECTOR_ENDPOINT = "http://localhost:6006/v1/traces"
# Set to "true" to launch the Phoenix UI from inside main.py/evals.py instead
# of running `uv run phoenix serve` in a separate terminal.
# PHOENIX_LAUNCH_UI = "false"
